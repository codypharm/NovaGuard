# Database Configuration
DATABASE_URL=postgresql+asyncpg://nova_user:nova_password@localhost:5432/nova_guard

# Application Settings
LOG_LEVEL=INFO
ENVIRONMENT=production

# AWS Configuration
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Nova API (OpenAI Compatible)
NOVA_API_KEY=

# OpenFDA API (optional - increases rate limits)
OPENFDA_API_KEY=

# Valyu Bio Search (optional)
VALYU_API_KEY=

# S3 Bucket for uploads
S3_BUCKET=
